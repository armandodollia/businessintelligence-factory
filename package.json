{
  "name": "business-intelligence-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-agent business intelligence factory",
  "license": "Apache-2.0",
  "author": "Armando Dollia",
  "repository": {
    "type": "git",
    "url": "https://github.com/armandodollia/businessintelligence-factory.git"
  },
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "test": "vitest run",
    "test:desktop-runtime": "tsx desktop/build.ts --test",
    "start": "tsx src/api/main.ts",
    "dev": "tsx watch src/api/main.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "web": "vite web",
    "build:web": "vite build web",
    "build:server": "npm run build:web && tsx scripts/build-server.ts",
    "doctor": "tsx scripts/doctor.ts",
    "desktop:dev": "npm run build:server && tsx desktop/build.ts --run",
    "dist:mac": "npm run build:server && tsx desktop/build.ts --mac",
    "dist:win": "npm run build:server && tsx desktop/build.ts --win",
    "smoke": "tsx scripts/smoke.ts",
    "feedback:report": "tsx scripts/feedback-report.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.85",
    "cron-parser": "5.10.2",
    "fflate": "0.8.3",
    "hono": "4.13.18",
    "parse5": "8.1.1",
    "saxes": "6.0.0",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.9.9",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
